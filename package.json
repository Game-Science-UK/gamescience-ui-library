{
  "name": "@gamescience/ui-library",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "GameScience.ai React design library and shadcn registry for multiplayer learning games",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "registry:serve": "npx --yes serve public/registry -p 4343",
    "pages:build": "npm run pages:build:versioned && npm run pages:build:latest",
    "pages:validate": "tsx scripts/validate-pages.ts",
    "pages:serve": "npx --yes serve pages-dist -p 4177",
    "theme:check": "tsx scripts/check-theme-contract.ts",
    "architecture:check": "tsx scripts/check-architecture.ts",
    "storybook:coverage": "tsx scripts/check-storybook-coverage.ts",
    "smoke:registry": "tsx scripts/smoke-registry-install.ts",
    "smoke:registry-overwrite": "tsx scripts/smoke-registry-overwrite.ts",
    "smoke:pages": "tsx scripts/smoke-pages-install.ts",
    "smoke:tailwind4": "tsx scripts/smoke-tailwind4-install.ts",
    "smoke:primitives": "tsx scripts/smoke-primitives-install.ts",
    "smoke:button-as-child": "tsx scripts/smoke-button-as-child.ts",
    "smoke:domain": "tsx scripts/smoke-domain-install.ts",
    "pages:build:versioned": "npm run registry:build && PAGES_STAGE=versioned tsx scripts/build-pages.ts",
    "pages:build:latest": "PAGES_STAGE=latest tsx scripts/build-pages.ts",
    "pages:validate:versioned": "PAGES_VALIDATE_MODE=versioned tsx scripts/validate-pages.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run theme:check && npm run architecture:check && npm run storybook:coverage && npm run test && npm run build && npm run build-storybook && npm run registry:build && npm run registry:validate && npm run pages:build:versioned && npm run pages:validate:versioned && npm run pages:build:latest && npm run pages:validate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@storybook/addon-a11y": "^9.0.18",
    "@storybook/addon-docs": "^9.0.18",
    "@storybook/react-vite": "^9.0.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.0.18",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^9.0.18",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
